# HTML — 매번 최신 확인 (배포 후 옛 화면이 보이지 않도록)
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 예약·결제 스크립트 — 매번 최신 확인.
# 기본값(4시간 캐시)이면 결제 버그를 고쳐도 그 시간만큼 손님에게 옛 코드가 나간다.
# 예약 스크립트는 이 규칙이 아니라 index.html의 ?v= 로 갱신한다.
# 이 배포에서는 /*.js · /booking.js · /js/* 어느 형태로도 .js에 헤더가 먹지 않았고
# (존 쪽 Browser Cache TTL 4시간이 덮어쓰는 것으로 보임), 규칙은 의도 표시로만 남긴다.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 이미지·아이콘 — 1년 캐시 (내용이 바뀌면 파일명을 바꿀 것)
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable

# API (Pages Functions) — JSON 고정 + 1분 캐시
/api/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=60, s-maxage=300
